# Copy to .env for local runs. Never commit .env.
SERVICE_NAME=fde-02-llm-applications
ENVIRONMENT=local
LOG_LEVEL=INFO

# LLM provider: mistral (default) | openai | deepseek | qwen | kimi | selfhosted
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
SELFHOSTED_API_KEY=

# Host port the desktop stacks publish on (127.0.0.1 only)
HOST_PORT=8000

# Corpus and index
DATA_DIR=data
INDEX_DIR=index

# Retrieval and answering
RETRIEVAL_MODE=hybrid          # bm25 | dense | hybrid
EMBEDDER=                      # lsa | mistral (empty: first available in the index)
RERANKER=lexical               # none | lexical | llm
ROUTE=true                     # resolve company and period to filings before searching
MIN_COVERAGE=0.2               # refusal gate (tuned on the FinanceBench dev half)
ANSWER_MODE=auto               # auto (Mistral if a key is set) | llm | extractive
LLM_ROLE=default               # default (mistral-small) | strong (mistral-large)
USE_TOOLS=true
